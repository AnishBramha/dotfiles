<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkWindow" id="window">
    <property name="can-focus">False</property>
    <child>
      <object class="GtkBox" id="body">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="valign">center</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkLabel" id="clock-label">
            <property name="visible">False</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="avatar-frame">
            <property name="visible">True</property>
            <property name="valign">center</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkImage" id="user-image">
                <property name="visible">True</property>
                <property name="file">/home/anish/Pictures/Library/Windows_7_Chrysanthemum.png</property>
                <property name="width-request">110</property>
                <property name="height-request">110</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="user-label">
            <property name="visible">True</property>
            <property name="label">Martin</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="input-box">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkEntry" id="input">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="visibility">False</property>
                <property name="placeholder-text">Password</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="input-button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label">➔</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>



